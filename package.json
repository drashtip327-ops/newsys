{
  "name": "payment-approval-mini-system",
  "private": true,
  "packageManager": "npm@12.1.0",
  "workspaces": ["backend"],
  "scripts": {
    "dev": "node scripts/run.cjs dev",
    "dev:frontend": "next dev frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && next build frontend",
    "build:frontend": "next build frontend",
    "start": "node scripts/run.cjs start",
    "lint": "eslint frontend backend/src shared tests",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && npm run typecheck --workspace backend",
    "test": "npm run test:unit && npm test --workspace backend",
    "test:unit": "tsc -p tests/tsconfig.json && node --test .test-build/tests/*.test.js"
  },
  "dependencies": { "next": "^16.2.0", "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "typescript": "^5.9.0", "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "eslint": "^9.0.0", "eslint-config-next": "^16.2.0", "tsx": "^4.0.0" }
}
